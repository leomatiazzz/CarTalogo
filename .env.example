# ==============================================================================
# CarTálogo - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente:
# cp .env.example .env
# ==============================================================================

# Configurações do Banco de Dados MySQL
MYSQL_ROOT_PASSWORD=sua_senha_forte_aqui
MYSQL_DATABASE=minimal_api
MYSQL_PORT=3306

# Configurações da API .NET 10
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5231
ConnectionStrings__MySql=Server=mysql;Database=minimal_api;Uid=root;Pwd=sua_senha_forte_aqui;

# Configurações de Segurança JWT (chave mínima de 256 bits / 32+ caracteres)
Jwt__Key=SUA_CHAVE_SUPER_SECRETA_JWT_COM_MAIS_DE_32_CARACTERES_AQUI!
Jwt__Issuer=MinimalAPI
Jwt__Audience=MinimalAPIClient

# Configurações do Frontend React
FRONTEND_PORT=3000
VITE_API_URL=/api
